<h1>Alumno {{alumno.padron}}</h1>

<dl>
  <dt>Padrón</dt>
  <dd>{{alumno.padron}}</dd>
  <dt>Nombre</dt>
  <dd>{{alumno.nombre}}</dd>
  <dt>Apellido</dt>
  <dd>{{alumno.apellido}}</dd>
</dl>

<form method="post" action="/alumnos/{{alumno.padron}}/eliminar">
  <button type="submit">Eliminar</button>
</form>

<p><a href="/alumnos">Volver al listado</a></p>
