<section>
  <h1>Ofertas laborales</h1>
  <p class="text-secondary">Conocé las oportunidades disponibles.</p>

  {{#if sinOfertas}}
  <div class="border border-primary-subtle rounded-3 bg-body-tertiary p-5 text-center d-flex flex-column align-items-center justify-content-center"
    style="border-style: dashed !important; min-height: 250px;">
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3"
      style="width: 3.25rem; height: 3.25rem;" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-4-4"></path>
      </svg>
    </span>
    <strong class="d-block mb-2">No hay ofertas publicadas</strong>
    <span class="text-secondary">Volvé a consultar más adelante.</span>
  </div>
  {{else}}
  <div class="row g-3">
    {{#each ofertas}}
    <article class="col-12">
      <div class="border rounded-3 bg-body p-4 shadow-sm d-flex justify-content-between align-items-center gap-3">
        <div>
          <h2 class="h5 mb-2">
            <a href="/ofertas/{{id}}" class="text-decoration-none">{{titulo}}</a>
          </h2>
          <p class="text-secondary mb-3">{{descripcion}}</p>
          <span class="fw-semibold">{{ubicacion}}</span>
        </div>

        {{#if puedeCerrar}}
        <form action="/ofertas/{{id}}/cerrar" method="post" class="flex-shrink-0">
          <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold px-3"
            style="--bs-btn-bg: var(--bs-danger-bg-subtle);">Cerrar oferta</button>
        </form>
        {{/if}}
      </div>
    </article>
    {{/each}}
  </div>
  {{/if}}
</section>
