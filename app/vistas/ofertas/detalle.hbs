<section>
  <h1>Detalle de la oferta</h1>
  <p class="text-secondary">Conocé la oportunidad y sus datos de contacto.</p>

  {{#if noEncontrada}}
  <div class="border border-primary-subtle rounded-3 bg-body-tertiary p-5 text-center d-flex flex-column align-items-center justify-content-center"
    style="border-style: dashed !important; min-height: 310px; background-color: #f8fafc !important;">
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3 fw-bold"
      style="width: 3.25rem; height: 3.25rem;" aria-hidden="true">!</span>
    <strong class="d-block mb-2">{{mensaje}}</strong>
    <span class="text-secondary mb-4">Es posible que la oferta ya no esté disponible.</span>
    <a href="/ofertas" class="btn btn-outline-primary">
      <span aria-hidden="true">←</span>
      Volver a ofertas
    </a>
  </div>
  {{else}}
  <article class="border rounded-3 bg-body p-4 shadow-sm">
    <h2 class="h4 mb-3">{{detalle.titulo}}</h2>
    <span class="badge text-primary-emphasis bg-primary-subtle mb-4">{{detalle.ubicacion}}</span>

    <h3 class="h6 text-uppercase text-secondary">Descripción</h3>
    <p>{{detalle.descripcion}}</p>

    <h3 class="h6 text-uppercase text-secondary mt-4">Contacto</h3>
    <a href="mailto:{{detalle.emailEmpresario}}" class="fw-semibold text-decoration-none">
      {{detalle.emailEmpresario}}
    </a>

    {{#if postulacionRegistrada}}
    <div class="alert alert-success mt-4" role="alert">Tu postulación fue registrada</div>
    {{/if}}

    {{#if puedePostularse}}
    <form action="/ofertas/{{detalle.id}}/postulaciones" method="post" class="mt-4">
      <button type="submit" class="btn btn-primary">Postularse</button>
    </form>
    {{/if}}

    <div class="mt-4">
      <a href="/ofertas" class="btn btn-outline-primary">
        <span aria-hidden="true">←</span>
        Volver
      </a>
    </div>
  </article>
  {{/if}}
</section>
