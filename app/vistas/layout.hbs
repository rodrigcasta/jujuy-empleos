<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{#if titulo}}{{titulo}}{{else}}Jujuy Empleos{{/if}}</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
</head>

<body class="bg-body-tertiary">
  <header>
    <nav class="navbar navbar-expand-md bg-dark" data-bs-theme="dark">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
          <svg class="flex-shrink-0" style="color: #0d6efd" width="30" height="24" viewBox="0 0 30 24" fill="none"
            aria-hidden="true">
            <path d="M7 7V5.5A1.5 1.5 0 0 1 8.5 4h5A1.5 1.5 0 0 1 15 5.5V7" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" />
            <rect x="2" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="2" />
            <path d="M2 12h18M9 12v2h4v-2" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path d="M24 7a5 5 0 0 0-5 5c0 4 5 9 5 9s5-5 5-9a5 5 0 0 0-5-5Z" fill="currentColor" />
            <circle cx="24" cy="12" r="1.75" class="text-dark" fill="currentColor" />
          </svg>
          <span>Jujuy Empleos</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-principal"
          aria-controls="menu-principal" aria-expanded="false" aria-label="Mostrar menú">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu-principal">
          <ul class="navbar-nav me-auto">

            <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
            <li class="nav-item"><a class="nav-link" href="/ofertas">Ofertas</a></li>
            {{#if usuarioActual}}
            <li class="nav-item"><a class="nav-link" href="/ofertas/nueva">Nueva oferta</a></li>{{/if}}
          </ul>
          {{#if usuarioActual}}
          <div class="d-flex flex-column flex-md-row align-items-md-center gap-2">
            <span class="navbar-text">{{usuarioActual.nombre}} ({{usuarioActual.email}})</span>
            <form method="post" action="/logout">
              <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
            </form>
          </div>
          {{else}}
          <div class="d-flex gap-2">
            <a class="btn btn-outline-light btn-sm" href="/login">Iniciar sesión</a>
            <a class="btn btn-primary btn-sm" href="/registro">Registrarse</a>
          </div>
          {{/if}}
        </div>
      </div>
    </nav>
  </header>
  <main class="container py-4">
    {{{body}}}
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>
