<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/alumnos">Alumnos</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{alumno.padron}}</li>
  </ol>
</nav>

<div class="card shadow-sm">
  <div class="card-body p-4">
    <h1 class="h3 mb-4">Alumno {{alumno.padron}}</h1>

    <dl class="row mb-4">
      <dt class="col-sm-3">Padrón</dt>
      <dd class="col-sm-9 alumno-padron">{{alumno.padron}}</dd>
      <dt class="col-sm-3">Nombre</dt>
      <dd class="col-sm-9 alumno-nombre">{{alumno.nombre}}</dd>
      <dt class="col-sm-3">Apellido</dt>
      <dd class="col-sm-9 alumno-apellido">{{alumno.apellido}}</dd>
    </dl>

    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="/alumnos">Volver al listado</a>
      <form method="post" action="/alumnos/{{alumno.padron}}/eliminar">
        <button type="submit" class="btn btn-danger">Eliminar</button>
      </form>
    </div>
  </div>
</div>
