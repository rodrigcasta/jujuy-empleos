<section>
    <h1>Mi cuenta</h1>

    <section class="border rounded-3 bg-body p-4 shadow-sm mt-3">
        <h2 class="h4 mb-2">Datos de la cuenta</h2>
        <p class="text-secondary">Información personal registrada en el sistema.</p>

        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <tbody>
                    <tr>
                        <th scope="row" class="table-light w-25">Nombre</th>
                        <td>{{nombre}}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="table-light w-25">Apellido</th>
                        <td>{{apellido}}</td>
                    </tr>
                    <tr>
                        <th scope="row" class="table-light w-25">Email</th>
                        <td>{{email}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>
