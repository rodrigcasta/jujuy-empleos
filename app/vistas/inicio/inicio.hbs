{{#if limiteOfertas}}
  <div class="row justify-content-center">
    <div class="col-xl-6 col-lg-7 col-md-9">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
          <h1 class="h2 fw-bold mb-4">Inicio</h1>
          <div class="alert alert-danger mb-0" role="alert">
            Alcanzaste el límite de publicaciones permitido por tu suscripción.
          </div>
        </div>
      </div>
    </div>
  </div>
{{else}}
  <div class="p-5 bg-body border rounded-3">
    <h1 class="display-5 fw-bold">Sistema de ofertas laborales</h1>
    <p class="lead mb-0">Consultá las ofertas laborales disponibles y encontrá nuevas oportunidades.</p>
  </div>
{{/if}}