<div class="row justify-content-center">
  <div class="col-md-10 col-lg-7">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-4">Registro</h1>

        {{#if error}}
          <div class="alert alert-danger" role="alert">{{error}}</div>
        {{/if}}

        <form method="post" action="/registro">
          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label for="nombre" class="form-label">Nombre</label>
              <input id="nombre" name="nombre" value="{{nuevo.nombre}}" class="form-control" autocomplete="given-name" maxlength="40" required />
            </div>
            <div class="col-sm-6">
              <label for="apellido" class="form-label">Apellido</label>
              <input id="apellido" name="apellido" value="{{nuevo.apellido}}" class="form-control" autocomplete="family-name" maxlength="40" required />
            </div>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input id="email" name="email" type="email" value="{{nuevo.email}}" class="form-control" autocomplete="email" maxlength="254" required />
          </div>
          <fieldset class="mb-3">
            <legend class="form-label">Suscripcion</legend>

            <div class="form-check">
              <input
                id="suscripcion-gratuita"
                name="suscripcion"
                value="Gratuita"
                type="radio"
                class="form-check-input"
              />
              <label for="suscripcion-gratuita" class="form-check-label">
                Gratuita
              </label>
            </div>

            <div class="form-check">
              <input
                id="suscripcion-profesional"
                name="suscripcion"
                value="Profesional"
                type="radio"
                class="form-check-input"
                checked
              />
              <label for="suscripcion-profesional" class="form-check-label">
                Profesional
              </label>
            </div>

            <div class="form-check">
              <input
                id="suscripcion-corporativa"
                name="suscripcion"
                value="Corporativa"
                type="radio"
                class="form-check-input"
              />
              <label for="suscripcion-corporativa" class="form-check-label">
                Corporativa
              </label>
            </div>
          </fieldset>
          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <label for="contrasena" class="form-label">Contraseña</label>
              <input id="contrasena" name="contrasena" type="password" class="form-control" autocomplete="new-password" minlength="8" aria-describedby="ayuda-contrasena" required />
              <div id="ayuda-contrasena" class="form-text">Mínimo 8 caracteres.</div>
            </div>
            <div class="col-sm-6">
              <label for="confirmacion" class="form-label">Repetir contraseña</label>
              <input id="confirmacion" name="confirmacion" type="password" class="form-control" autocomplete="new-password" minlength="8" required />
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-100">Registrarse</button>
        </form>
      </div>
    </div>
    <p class="text-center mt-3">¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>
  </div>
</div>
