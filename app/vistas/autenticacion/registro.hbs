<style>
  .opcion-seleccion {
    color: var(--bs-body-color);
    background-color: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
  }

  .opcion-seleccion:hover {
    color: var(--bs-body-color);
    background-color: var(--bs-primary-bg-subtle);
    border-color: var(--bs-primary);
  }

  .btn-check:checked + .opcion-seleccion {
    color: var(--bs-body-color);
    background-color: var(--bs-primary-bg-subtle);
    border-color: var(--bs-primary);
    box-shadow: 0 0 0 0.125rem rgb(13 110 253 / 15%);
  }
</style>

<div class="row justify-content-center">
  <div class="col-md-10 col-lg-7">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-2">Crear cuenta</h1>
        <p class="text-secondary mb-4">Registrate para encontrar oportunidades laborales o publicar ofertas.</p>

        {{#if error}}
          <div class="alert alert-danger" role="alert">{{error}}</div>
        {{/if}}

        <form method="post" action="/registro">
          <fieldset class="mb-4">
            <legend class="h5 mb-3">Quiero registrarme como</legend>
            <div class="row g-3">
              <div class="col-sm-6">
                <input
                  id="tipo-empresario"
                  name="tipo_usuario"
                  value="Empresario"
                  type="radio"
                  class="btn-check"
                  autocomplete="off"
                  required
                />
                <label for="tipo-empresario" class="btn opcion-seleccion w-100 h-100 text-start p-3">
                  <span class="d-block fw-semibold">Empresario</span>
                  <small class="d-block">Quiero publicar ofertas laborales</small>
                </label>
              </div>
              <div class="col-sm-6">
                <input
                  id="tipo-aspirante"
                  name="tipo_usuario"
                  value="Aspirante"
                  type="radio"
                  class="btn-check"
                  autocomplete="off"
                  required
                />
                <label for="tipo-aspirante" class="btn opcion-seleccion w-100 h-100 text-start p-3">
                  <span class="d-block fw-semibold">Aspirante</span>
                  <small class="d-block">Quiero postularme a ofertas laborales</small>
                </label>
              </div>
            </div>
          </fieldset>
          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label for="nombre" class="form-label">Nombre
                <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input
                id="nombre"
                name="nombre"
                value="{{nuevo.nombre}}"
                class="form-control"
                autocomplete="given-name"
                maxlength="40"
                required
              />
            </div>
            <div class="col-sm-6">
              <label for="apellido" class="form-label">Apellido
                <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input
                id="apellido"
                name="apellido"
                value="{{nuevo.apellido}}"
                class="form-control"
                autocomplete="family-name"
                maxlength="40"
                required
              />
            </div>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email
              <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              value="{{nuevo.email}}"
              class="form-control"
              autocomplete="email"
              maxlength="254"
              required
            />
          </div>
          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <label for="contrasena" class="form-label">
                Contraseña
                <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input
                id="contrasena"
                name="contrasena"
                type="password"
                class="form-control"
                autocomplete="new-password"
                minlength="8"
                aria-describedby="ayuda-contrasena"
                required
              />
              <div id="ayuda-contrasena" class="form-text">
                Entre 8 y 20 caracteres, con al menos una letra minúscula, una letra mayúscula, un número y dos
                símbolos.
              </div>
            </div>
            <div class="col-sm-6">
              <label for="confirmacion" class="form-label">
                Repetir contraseña
                <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input
                id="confirmacion"
                name="confirmacion"
                type="password"
                class="form-control"
                autocomplete="new-password"
                minlength="8"
                required
              />
            </div>
          </div>
          <fieldset id="opciones-suscripcion" class="mb-3" hidden>
            <legend class="form-label">Tipo de suscripción</legend>

            <div class="row g-3">
              <div class="col-md-4">
                <input
                  id="suscripcion-gratuita"
                  name="suscripcion"
                  value="Gratuita"
                  type="radio"
                  class="btn-check"
                  autocomplete="off"
                />
                <label for="suscripcion-gratuita" class="btn opcion-seleccion w-100 h-100 text-start p-3">
                  <span class="d-block fw-semibold">Gratuita</span>
                  <small class="d-block">Una publicación sin cargo</small>
                </label>
              </div>

              <div class="col-md-4">
                <input
                  id="suscripcion-profesional"
                  name="suscripcion"
                  value="Profesional"
                  type="radio"
                  class="btn-check"
                  autocomplete="off"
                  checked
                />
                <label for="suscripcion-profesional" class="btn opcion-seleccion w-100 h-100 text-start p-3">
                  <span class="d-block fw-semibold">Profesional</span>
                  <small class="d-block">Hasta cinco publicaciones sin cargo</small>
                </label>
              </div>

              <div class="col-md-4">
                <input
                  id="suscripcion-corporativa"
                  name="suscripcion"
                  value="Corporativa"
                  type="radio"
                  class="btn-check"
                  autocomplete="off"
                />
                <label for="suscripcion-corporativa" class="btn opcion-seleccion w-100 h-100 text-start p-3">
                  <span class="d-block fw-semibold">Corporativa</span>
                  <small class="d-block">Publicaciones sin límite</small>
                </label>
              </div>
            </div>
          </fieldset>
          <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
        </form>
      </div>
    </div>
    <p class="text-center mt-3">¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>
  </div>
</div>

<script>
  const opcionesTipoUsuario = document.querySelectorAll('input[name="tipo_usuario"]');
  const opcionesSuscripcion = document.getElementById("opciones-suscripcion");
  const suscripciones = opcionesSuscripcion.querySelectorAll('input[name="suscripcion"]');

  const actualizarSuscripciones = () => {
    const tipoSeleccionado = document.querySelector('input[name="tipo_usuario"]:checked')?.value;
    const esEmpresario = tipoSeleccionado === "Empresario";
    opcionesSuscripcion.hidden = !esEmpresario;
    suscripciones.forEach((suscripcion) => {
      suscripcion.disabled = !esEmpresario;
    });
  };

  opcionesTipoUsuario.forEach((opcion) => opcion.addEventListener("change", actualizarSuscripciones));
  actualizarSuscripciones();
</script>
